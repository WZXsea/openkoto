{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKoto Desktop",
  "version": "0.8.0",
  "identifier": "com.openkoto.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenKoto Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' http://127.0.0.1:19420 data: blob:; connect-src 'self' http://127.0.0.1:19421 http://localhost:1420 http://127.0.0.1:1420 ws://localhost:1420 ws://127.0.0.1:1420; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/videos/**",
          "$APPDATA/books/**",
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "AI-powered article reader and translator",
    "longDescription": "OpenKoto Desktop is a powerful AI-powered application for reading, translating, and analyzing articles. Use your own API keys to access the latest AI models.",
    "externalBin": [],
    "resources": {
      "resources/pdf-assets": "resources/pdf-assets",
      "resources/backend": "backend",
      "resources/postgres": "postgres",
      "resources/node": "node",
      "../agent-worker/dist": "agent-worker/dist",
      "../agent-worker/package.json": "agent-worker/package.json",
      "../agent-worker/node_modules": "agent-worker/node_modules"
    },
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
